{
  "name": "gisoo-vscode",
  "displayName": "Gisoo — AI Coding Agent",
  "description": "An agentic coding assistant for VS Code, powered by Gisoo: plans, reads your code, edits with diffs you approve, runs commands, and shows your credit.",
  "version": "1.0.0",
  "publisher": "gisoo",
  "license": "MIT",
  "author": {
    "name": "NetArz",
    "url": "https://gisoo.pro"
  },
  "homepage": "https://gisoo.pro/vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/netarz/gisoo-vscode"
  },
  "bugs": {
    "url": "https://github.com/netarz/gisoo-vscode/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f1115",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "agent",
    "coding assistant",
    "gisoo",
    "claude",
    "gpt",
    "gemini",
    "deepseek",
    "persian"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces%",
      "restrictedConfigurations": [
        "gisoo.baseUrl",
        "gisoo.region",
        "gisoo.permissionMode",
        "gisoo.compat.claude",
        "gisoo.graphify.autoInstall",
        "gisoo.browserPath",
        "gisoo.webFetch.enabled",
        "gisoo.allowedCommands",
        "gisoo.customInstructions",
        "gisoo.maxSteps",
        "gisoo.maxCostPerTask"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gisoo",
          "title": "%view.container.title%",
          "icon": "media/gisoo.svg"
        }
      ]
    },
    "views": {
      "gisoo": [
        {
          "type": "webview",
          "id": "gisoo.chat",
          "name": "%view.chat.name%",
          "icon": "media/gisoo.svg",
          "contextualTitle": "Gisoo"
        },
        {
          "type": "tree",
          "id": "gisoo.agents",
          "name": "%view.agents.name%",
          "icon": "media/gisoo.svg",
          "contextualTitle": "Gisoo",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "gisoo.newChat",
        "title": "%command.newChat%",
        "category": "Gisoo",
        "icon": "$(add)"
      },
      {
        "command": "gisoo.focus",
        "title": "%command.focus%",
        "category": "Gisoo",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "gisoo.signIn",
        "title": "%command.signIn%",
        "category": "Gisoo"
      },
      {
        "command": "gisoo.signInWithKey",
        "title": "%command.signInWithKey%",
        "category": "Gisoo"
      },
      {
        "command": "gisoo.enterCode",
        "title": "%command.enterCode%",
        "category": "Gisoo"
      },
      {
        "command": "gisoo.signOut",
        "title": "%command.signOut%",
        "category": "Gisoo"
      },
      {
        "command": "gisoo.openSettings",
        "title": "%command.openSettings%",
        "category": "Gisoo",
        "icon": "$(gear)"
      },
      {
        "command": "gisoo.attachFile",
        "title": "%command.attachFile%",
        "category": "Gisoo"
      },
      {
        "command": "gisoo.attachSelection",
        "title": "%command.attachSelection%",
        "category": "Gisoo"
      },
      {
        "command": "gisoo.stop",
        "title": "%command.stop%",
        "category": "Gisoo",
        "icon": "$(debug-stop)"
      },
      {
        "command": "gisoo.showAccount",
        "title": "%command.showAccount%",
        "category": "Gisoo"
      },
      {
        "command": "gisoo.installSkill",
        "title": "%command.installSkill%",
        "category": "Gisoo"
      },
      {
        "command": "gisoo.rebuildGraph",
        "title": "%command.rebuildGraph%",
        "category": "Gisoo"
      },
      {
        "command": "gisoo.importClaudeMemory",
        "title": "%command.importClaudeMemory%",
        "category": "Gisoo"
      },
      {
        "command": "gisoo.showAgents",
        "title": "%command.showAgents%",
        "category": "Gisoo",
        "icon": "$(server-process)"
      },
      {
        "command": "gisoo.agent.open",
        "title": "%command.agent.open%",
        "category": "Gisoo",
        "icon": "$(open-preview)"
      },
      {
        "command": "gisoo.agent.stop",
        "title": "%command.agent.stop%",
        "category": "Gisoo",
        "icon": "$(debug-stop)"
      },
      {
        "command": "gisoo.agent.retry",
        "title": "%command.agent.retry%",
        "category": "Gisoo",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gisoo.signIn",
          "when": "!gisoo.signedIn"
        },
        {
          "command": "gisoo.signInWithKey",
          "when": "!gisoo.signedIn"
        },
        {
          "command": "gisoo.signOut",
          "when": "gisoo.signedIn"
        },
        {
          "command": "gisoo.stop",
          "when": "gisoo.running"
        },
        {
          "command": "gisoo.attachSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "gisoo.attachFile",
          "when": "editorIsOpen"
        },
        {
          "command": "gisoo.agent.open",
          "when": "false"
        },
        {
          "command": "gisoo.agent.stop",
          "when": "false"
        },
        {
          "command": "gisoo.agent.retry",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "gisoo.attachSelection",
          "when": "editorHasSelection",
          "group": "gisoo@1"
        }
      ],
      "view/title": [
        {
          "command": "gisoo.newChat",
          "when": "view == gisoo.chat",
          "group": "navigation@1"
        },
        {
          "command": "gisoo.stop",
          "when": "view == gisoo.chat && gisoo.running",
          "group": "navigation@2"
        },
        {
          "command": "gisoo.openSettings",
          "when": "view == gisoo.chat",
          "group": "navigation@3"
        },
        {
          "command": "gisoo.showAgents",
          "when": "view == gisoo.agents",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "gisoo.agent.stop",
          "when": "view == gisoo.agents && viewItem == agent.running",
          "group": "inline@1"
        },
        {
          "command": "gisoo.agent.open",
          "when": "view == gisoo.agents && viewItem == agent.finished",
          "group": "inline@1"
        },
        {
          "command": "gisoo.agent.retry",
          "when": "view == gisoo.agents && viewItem == agent.finished",
          "group": "inline@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gisoo.focus",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "!terminalFocus"
      },
      {
        "command": "gisoo.newChat",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "view.gisoo.chat.visible && !terminalFocus"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "gisoo.region": {
          "scope": "application",
          "type": "string",
          "enum": [
            "global",
            "iran"
          ],
          "enumDescriptions": [
            "%config.region.global%",
            "%config.region.iran%"
          ],
          "default": "global",
          "description": "%config.region%",
          "order": 1
        },
        "gisoo.baseUrl": {
          "scope": "application",
          "type": "string",
          "default": "",
          "markdownDescription": "%config.baseUrl%",
          "order": 2
        },
        "gisoo.model": {
          "type": "string",
          "default": "",
          "description": "%config.model%",
          "order": 3
        },
        "gisoo.permissionMode": {
          "scope": "application",
          "type": "string",
          "enum": [
            "ask",
            "autoEdit",
            "plan"
          ],
          "enumDescriptions": [
            "%config.permissionMode.ask%",
            "%config.permissionMode.autoEdit%",
            "%config.permissionMode.plan%"
          ],
          "default": "ask",
          "description": "%config.permissionMode%",
          "order": 4
        },
        "gisoo.maxCostPerTask": {
          "scope": "application",
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%config.maxCostPerTask%",
          "order": 5
        },
        "gisoo.showCost": {
          "type": "boolean",
          "default": true,
          "description": "%config.showCost%",
          "order": 6
        },
        "gisoo.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "fa"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.fa%"
          ],
          "default": "auto",
          "description": "%config.language%",
          "order": 7
        },
        "gisoo.subagentModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.subagentModel%",
          "order": 8
        },
        "gisoo.agents.maxParallel": {
          "scope": "application",
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "description": "%config.agents.maxParallel%",
          "order": 9
        },
        "gisoo.agents.maxTurns": {
          "scope": "application",
          "type": "integer",
          "default": 25,
          "minimum": 1,
          "maximum": 100,
          "description": "%config.agents.maxTurns%",
          "order": 10
        },
        "gisoo.compat.claude": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.compat.claude%",
          "order": 11
        },
        "gisoo.graphify.autoInstall": {
          "scope": "application",
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "%config.graphify.autoInstall.ask%",
            "%config.graphify.autoInstall.always%",
            "%config.graphify.autoInstall.never%"
          ],
          "default": "ask",
          "markdownDescription": "%config.graphify.autoInstall%",
          "order": 12
        },
        "gisoo.graphify.budget": {
          "type": "integer",
          "default": 1500,
          "minimum": 200,
          "maximum": 4000,
          "description": "%config.graphify.budget%",
          "order": 13
        },
        "gisoo.browserPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.browserPath%",
          "order": 14
        },
        "gisoo.webFetch.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "%config.webFetch.enabled%",
          "order": 15
        },
        "gisoo.allowedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "%config.allowedCommands%",
          "order": 16
        },
        "gisoo.customInstructions": {
          "type": "string",
          "default": "",
          "scope": "application",
          "editPresentation": "multilineText",
          "description": "%config.customInstructions%",
          "order": 17
        },
        "gisoo.maxSteps": {
          "type": "integer",
          "default": 60,
          "minimum": 1,
          "maximum": 1000,
          "scope": "application",
          "description": "%config.maxSteps%",
          "order": 18
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview",
    "lint": "eslint .",
    "test:unit": "mocha -r ./test/register.cjs \"test/unit/**/*.test.ts\"",
    "test:integration": "node esbuild.mjs && node ./test/runIntegration.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration",
    "package": "npm run build -- --production && vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.0",
    "mocha": "^12.0.3",
    "preact": "^11.2.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "esbuild@0.28.2": true
  }
}
